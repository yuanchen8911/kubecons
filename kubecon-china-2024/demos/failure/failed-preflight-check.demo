# Demo: inject fault to initContainer to simulate a preflight check error in an existing minikube cluster
kubectl config use-context minikube
kubectl get nodes

# Install kwok ...
# kubectl apply -f https://github.com/kubernetes-sigs/kwok/releases/download/v0.6.0/kwok.yaml --wait
# kubectl apply -f https://github.com/kubernetes-sigs/kwok/releases/download/v0.6.0/stage-fast.yaml
# kubectl apply -f https://github.com/kubernetes-sigs/kwok/raw/main/kustomize/stage/pod/chaos/pod-init-container-running-failed.yaml
kubectl get pod -n kube-system | grep kwok
kubectl get stages; sleep 2
clear
# Add a virtual GPU node
export WORK_DIR=.
grep allocatable ${WORK_DIR}/virtual-gpu-node.yaml -A 15; sleep 3
clear
kubectl apply -f ${WORK_DIR}/virtual-gpu-node.yaml
kubectl get nodes
kubectl describe node virtual-gpu-node | grep Allocatable -A 15; sleep 2
clear 
# Create a pod and inject an error to initContainer to simulate a preflight check error
grep failed ${WORK_DIR}/failed-pod.yaml; sleep 20
clear
kubectl apply -f ${WORK_DIR}/failed-pod.yaml
kubectl get pod
clear
kubectl describe pod failed-pod | grep "Init Container" -A 15; sleep 10

# Clean up
kubectl delete -f ${WORK_DIR}/failed-pod.yaml
kubectl delete -f ${WORK_DIR}/virtual-gpu-node.yaml

clear
kubectl get nodes
kubectl get pods

# Thank you!
